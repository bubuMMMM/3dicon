# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Optional: pin a model. If empty, the API discovers a compatible image model.
OPENROUTER_IMAGE_MODEL=

# Optional: defaults to the video model used by the original plugin.
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0

# Optional metadata sent to OpenRouter.
APP_URL=
