# icon-loop — copy to .env and fill in what you plan to use.
# Nothing here is ever printed by the tool; keys are read and passed straight
# to the provider.

# --- Image generation: pick ONE backend ------------------------------------
# openai     — GPT Image (the newest gpt-image-* on your account is resolved
#              at runtime, so you do not pin a version that may not exist).
# gemini     — Gemini "Nano Banana" image models.
# openrouter — one key for both, via the unified Image API. Useful if you
#              already route everything through OpenRouter, or if you do not
#              hold a direct OpenAI/Google key.
ICONLOOP_IMAGE_BACKEND=openai

OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional override. Leave blank to auto-resolve the newest available model.
# openai     e.g. gpt-image-2.5-sunburst
# gemini     e.g. gemini-3-pro-image
# openrouter e.g. openai/gpt-image-2.5
ICONLOOP_IMAGE_MODEL=

# --- Animation --------------------------------------------------------------
# Required. Kling image-to-video runs on Replicate.
REPLICATE_API_TOKEN=

# Optional override; the current version is resolved from the API when blank.
ICONLOOP_KLING_MODEL=kwaivgi/kling-v2.5-turbo-pro
